pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: sec-num
    elementType: text
    bounds: [60, 32, 44, 30]
    content:
      fontSize: 22
      color: "$accent"
      fontFamily: 思源宋体
      bold: true
      text: "06"
  - elementId: page-title
    elementType: text
    bounds: [112, 34, 700, 30]
    content:
      style: "$pageTitle"
      text: 混淆矩阵与误差分析
  - elementId: head-rule
    elementType: shape
    bounds: [60, 76, 840, 1.5]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  # 左：混淆矩阵
  - elementId: cm-img
    elementType: image
    bounds: [60, 104, 380, 340]
    src: media/resnet18_finetune_confusion_matrix.png
    fit: {mode: contain}
  - elementId: cm-caption
    elementType: text
    bounds: [60, 450, 380, 16]
    content:
      style: "$small"
      align: [center, top]
      text: 图 4　测试集混淆矩阵（1600 张）
  # 右：误差分析
  - elementId: ana-heading
    elementType: text
    bounds: [500, 104, 400, 22]
    content:
      style: "$heading"
      text: 错在哪里，为什么
  - elementId: ana-1
    elementType: text
    bounds: [500, 136, 400, 88]
    content:
      style: "$body"
      text: |
        <p><span style="color:$accent"><strong>筛查最关键指标达标</strong></span>：无肿瘤召回率 <strong>100%</strong>、垂体瘤 <strong>99.5%</strong>——辅助筛查场景下"不漏诊"优先于"分得细"。</p>
  - elementId: ana-line-1
    elementType: shape
    bounds: [500, 236, 400, 1]
    shapeName: rect
    fill: {type: solid, color: "#D8CFC0"}
  - elementId: ana-2
    elementType: text
    bounds: [500, 250, 400, 108]
    content:
      style: "$body"
      text: |
        <p><span style="color:$accent"><strong>主要混淆：胶质瘤 → 脑膜瘤（67 例）</strong></span>。二者在 T1 增强 MRI 上都表现为明显强化病灶，影像表型相近；临床上同样需要灌注、波谱等额外序列鉴别——<strong>模型犯的正是"像人一样的错误"</strong>。</p>
  - elementId: ana-line-2
    elementType: shape
    bounds: [500, 370, 400, 1]
    shapeName: rect
    fill: {type: solid, color: "#D8CFC0"}
  - elementId: ana-3
    elementType: text
    bounds: [500, 384, 400, 88]
    content:
      style: "$body"
      text: |
        <p><span style="color:$accent"><strong>改进方向</strong></span>：引入病灶分割先验引导分类；增加胶质瘤样本或采用加权损失；升级到多序列 / 3D MRI 输入。</p>
  - elementId: footer-left
    elementType: text
    bounds: [60, 512, 400, 14]
    content:
      style: "$small"
      fontSize: 9
      text: 脑肿瘤 MRI 图像分类辅助诊断系统 · 认知科学大作业
  - elementId: footer-page
    elementType: text
    bounds: [860, 512, 40, 14]
    content:
      style: "$small"
      fontSize: 9
      align: [right, top]
      text: "07"
